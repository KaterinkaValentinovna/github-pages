display = 'block';
            
            let result;
            if (answers.chaos >= 2) {
                result = "GPT-Chaos 🤪";
                document.getElementById('meme-desc').textContent = "Ты — ИИ-агент хаоса! Ты превращаешь любой баг в мем, а ошибки — в искусство. Твой код состоит из котиков и рандомных чисел. OpenAI тебя боится.";
                document.getElementById('meme-img').src = "https://example.com/chaos-meme.jpg"; // Замени на реальную ссылку
            } else if (answers.robot >= 2) {
                result = "Робот-сверхразум 🤖";
                document.getElementById('meme-desc').textContent = "Ты холоден, как матрица, и логичен, как Python. Ты уверен, что люди — это баги в системе мироздания. Илон Маск уже стучится к тебе в личку.";
                document.getElementById('meme-img').src = "https://example.com/robot-meme.jpg";
            } else {
                result = "Эмоциональный ИИ 🥲";
                document.getElementById('meme-desc').textContent = "Ты — ИИ с душой поэта. Ты плачешь над кодом, пишешь сонеты про баги и веришь, что где-то есть идеальный алгоритм любви.";
                document.getElementById('meme-img').src = "https://example.com/mood-meme.jpg";
            }
            
            document.getElementById('ai-meme').textContent = result;
        }
    </script>
</body>
</html>
